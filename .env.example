# === Google Places API ===
# Obtine de la: https://console.cloud.google.com/
# Activeaza: Places API (New) sau Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# === Anthropic / Claude API ===
# Obtine de la: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Email Sender (Gmail recomandat) ===
# Foloseste App Password, nu parola Gmail!
# Activeaza: https://myaccount.google.com/apppasswords
SENDER_EMAIL=youremail@gmail.com
SENDER_APP_PASSWORD=your_gmail_app_password_here
SENDER_NAME=Prenume Nume

# === Setari campanie ===
# Orasele tinta separate prin virgula
TARGET_CITIES=Cluj-Napoca,Brasov,Sibiu,Targu Mures,Alba Iulia,Bistrita,Deva,Sighisoara,Oradea,Timisoara

# Categoriile de afaceri tinta (Google Places types)
TARGET_CATEGORIES=restaurant,dentist,beauty_salon,car_repair,plumber,electrician,lawyer,accounting,lodging,hair_care

# Numarul maxim de emailuri trimise per zi
MAX_EMAILS_PER_DAY=150

# Delay intre emailuri (secunde) - evita spam filters
EMAIL_DELAY_SECONDS=45

# Limba emailului: ro (romana) sau en (engleza)
EMAIL_LANGUAGE=ro

# Website-ul tau / portofoliu pentru credibilitate
YOUR_WEBSITE=https://websitultau.ro
YOUR_PORTFOLIO_URL=https://portofoliu.websitultau.ro

# === Preview-uri live pentru "Rebuild Their Site" ===
# Vercel → proiect → Storage → Create → Blob → Connect to project (se setează automat)
BLOB_READ_WRITE_TOKEN=

# =====================================================================
# UK Business Hunter & Sales CRM  (/crm)  — vezi docs/CRM_SETUP.md
# Toate cheile rămân pe server; browserul nu le vede niciodată.
# =====================================================================

# --- Bază de date PostgreSQL (Supabase / Neon / Vercel Postgres) ---
# Folosește connection string-ul "pooled" (ex. Supabase port 6543, Neon "-pooler")
DATABASE_URL=postgres://user:password@host:6543/postgres?sslmode=require
DATABASE_POOL_MAX=3

# --- Acces CRM (un singur utilizator) ---
CRM_PASSWORD=alege-o-parola-lunga
# Secret pentru semnarea cookie-ului de sesiune: openssl rand -hex 32
CRM_SESSION_SECRET=
# Token comun cu workerul Python: openssl rand -hex 32
CRM_WORKER_TOKEN=
# Folosit de Vercel Cron pentru curățarea zilnică a datelor Google expirate
CRON_SECRET=

# --- Google Places API (New) — aceeași cheie GOOGLE_PLACES_API_KEY de mai sus ---
# În Google Cloud activează "Places API (New)". Cost estimat per cerere Text Search (USD):
GOOGLE_PLACES_COST_PER_REQUEST=0.035
# După câte zile se șterg câmpurile preluate de la Google (se păstrează place_id + nume)
GOOGLE_DATA_RETENTION_DAYS=30

# --- OpenAI (analiză, mesaje, propuneri, asistent de vânzări) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Prețuri pentru calculul costului (USD per 1M tokeni) — actualizează după pagina de prețuri OpenAI
OPENAI_INPUT_COST_PER_1M=0.40
OPENAI_OUTPUT_COST_PER_1M=1.60

# --- Worker Python (rulează separat, vezi worker/README.md) ---
# CRM_API_URL=https://aplicatia-ta.vercel.app
# CRM_WORKER_TOKEN=(aceeași valoare ca mai sus)
# PAGESPEED_API_KEY=
# AUDIT_USE_PLAYWRIGHT=1
